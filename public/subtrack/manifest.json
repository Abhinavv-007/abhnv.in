{
  "name": "SubTrack - Your Subscription Tracker",
  "short_name": "SubTrack",
  "description": "Track, manage, and optimize your subscriptions with AI-powered insights and notifications",
  "icons": [
    {
      "src": "/subtrack/_static/favicons/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/subtrack/_static/favicons/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/subtrack/_static/favicons/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/subtrack/_static/favicons/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "start_url": "/subtrack/dashboard?source=pwa",
  "scope": "/",
  "theme_color": "#b2673f",
  "background_color": "#b2673f",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "categories": ["finance", "productivity", "utilities"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Add Subscription",
      "short_name": "Add",
      "description": "Add a new subscription",
      "url": "/subtrack/dashboard/subscriptions?action=add",
      "icons": [
        {
          "src": "/subtrack/_static/favicons/android-chrome-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "View Notifications",
      "short_name": "Notifications",
      "description": "View your notifications",
      "url": "/subtrack/dashboard/notifications",
      "icons": [
        {
          "src": "/subtrack/_static/favicons/android-chrome-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "related_applications": [],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "protocol_handlers": [
    {
      "protocol": "web+subtrack",
      "url": "/subtrack/dashboard?action=%s"
    }
  ]
}
